{
  "manifest_version": 3,
  "name": "Sorteo: extractor de comentarios",
  "version": "1.3",
  "description": "Abre una publicación de Instagram en segundo plano, extrae sus comentarios y los envía a tu página de sorteos.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_idle"
    }
  ]
}